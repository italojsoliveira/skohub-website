<https://knb.poolparty.biz/documentmetadata/Documenttype> a skos:Concept;
  skos:prefLabel "Documenttype"@nl;
  skos:definition """Classificatie brengt samenhang tussen
records (ordening). Classificatie moet herleidbaar
zijn tot activiteiten dan wel werkprocessen
om die samenhang te kunnen duiden
en om van daaruit records in hun onderlinge
relatie te kunnen zoeken. Sluit bovendien
goed aan bij belevingswereld van gebruiker."""@nl;
  skos:broader <https://knb.poolparty.biz/documentmetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/documentmetadata/Bronapplicatie>, <https://knb.poolparty.biz/documentmetadata/String>,
    <https://knb.poolparty.biz/documentmetadata/nul-tot-een>, <https://knb.poolparty.biz/documentmetadata/documentAspect>,
