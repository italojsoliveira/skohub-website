<https://knb.poolparty.biz/documentmetadata/Object-type> a skos:Concept;
  skos:prefLabel "Object type"@nl;
  skos:definition "Bedoeld om records op verschillende hiërarchische niveaus (bijvoorbeeld: document, dossier, bestand) te kunnen groeperen. Door afspraken te maken tussen organisaties over te onderscheiden aggregatieniveaus kan informatie/records gemakkelijker uitgewisseld worden."@nl;
  skos:scopeNote "Content type 'rdoc:document' met cm:document als base type"@nl;
  skos:broader <https://knb.poolparty.biz/documentmetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/documentmetadata/Bronapplicatie>, <https://knb.poolparty.biz/documentmetadata/String>,
    <https://knb.poolparty.biz/documentmetadata/een-tot-een>, <https://knb.poolparty.biz/documentmetadata/Aggregatieniveau>;
  skos:inScheme <https://knb.poolparty.biz/documentmetadata/document> .

