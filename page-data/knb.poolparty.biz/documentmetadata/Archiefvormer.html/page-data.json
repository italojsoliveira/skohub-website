{"componentChunkName":"component---src-components-concept-jsx","path":"/knb.poolparty.biz/documentmetadata/Archiefvormer.html","result":{"pageContext":{"node":{"id":"https://knb.poolparty.biz/documentmetadata/Archiefvormer","type":"Concept","prefLabel":{"nl":"Archiefvormer"},"altLabel":null,"hiddenLabel":null,"definition":{"nl":"De organisatie die verantwoordelijk is voor het opmaken en/of ontvangen van het informatieobject."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"nl":["On der archiefvormer wordt verstaan de (overheids)organisatie of het organisatieonderdeel waar het informatieobject gecreëerd of ontvangen is.\nHet betreft niet externe betrokkenen zoals afzenders (zoals burgers en bedrijven) van brieven of aanvragers van vergunningen. Deze worden beschreven met behulp van betrokkene. \nHet gaat hier ook niet om de verantwoordelijkheid voor een beheeractiviteit (die wordt vastgelegd met behulp van event)."]},"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://knb.poolparty.biz/documentmetadata/Veldnaam-Relatie-met-MDTO","prefLabel":{"nl":"Veldnaam Relatie met MDTO"}},"broaderTransitive":null,"related":[{"id":"https://knb.poolparty.biz/documentmetadata/Gewijzigd-door","prefLabel":{"nl":"Gewijzigd door"}},{"id":"https://knb.poolparty.biz/documentmetadata/Gewijzigd-door_2","prefLabel":{"nl":"Gewijzigd door"}},{"id":"https://knb.poolparty.biz/documentmetadata/Aangemaakt-door","prefLabel":{"nl":"Aangemaakt door"}},{"id":"https://knb.poolparty.biz/documentmetadata/Aangemaakt-door_2","prefLabel":{"nl":"Aangemaakt door"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://knb.poolparty.biz/documentmetadata/document","title":{"nl":"document"}}],"inSchemeAll":[{"id":"https://knb.poolparty.biz/documentmetadata/document"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":""}},"staticQ