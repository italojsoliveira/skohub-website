<https://knb.poolparty.biz/dossiermetadata/Dossiertype> a skos:Concept;
  dcterms:creator <https://knb.poolparty.biz/user/9cbe93b4-c9be-4102-93aa-1f7600ee191a>;
  dcterms:created "2026-02-27T13:09:46.659Z"^^xsd:dateTime;
