  skos:inScheme <https://knb.poolparty.biz/dossiertypemetadata/dossiertype> .

<https://knb.poolparty.biz/dossiertypemetadata/Werkproces> a skos:Concept;
  skos:prefLabel "Werkproces"@nl;
  skos:definition "Werkproces waarin het dossiertype valt. Vaak is dit ook een omschrijving van de (bedrijfs)activiteit"@nl;
  skos:scopeNote "Categorie, werkproces, dossiertype en resultaattype worden in een classificatieschema vastgelegd"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/dossiertypemetadata/DMS>, <https://knb.poolparty.biz/dossiertypemetadata/String>,
    <https://knb.poolparty.biz/dossiertypemetadata/een-tot-een>, <https://knb.poolparty.biz/dossiertypemetadata/dossierTypeAspect>,
    <https://knb.poolparty.biz/dossiertypemetadata/Classificatie>;
  skos:inScheme <https://knb.poolparty.biz/dossiertypemetadata/dossiertype> .

<https://knb.poolparty.biz/dossiertypemetadata/Dossiertype> a skos:Concept;
  skos:prefLabel "Dossiertype"@nl;
  skos:definition """Classificatie brengt samenhang tussen records (ordening). Classificatie moet herleidbaar zijn tot activiteiten dan wel werkprocessen om die samenhang te kunnen duiden en om van daaruit records in hun onderlinge
relatie te kunnen zoeken. Sluit bovendien goed aan bij belevingswereld van gebruiker."""@nl;
  skos:scopeNote "Categorie, werkproces, dossiertype en resultaattype worden in een classificatieschema vastgelegd"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/dossiertypemetadata/DMS>, <https://knb.poolparty.biz/dossiertypemetadata/String>,
    <https://knb.poolparty.biz/dossiertypemetadata/een-tot-een>, <https://knb.poolparty.biz/dossiertypemetadata/dossierTypeAspect>,
    <https://knb.poolparty.biz/dossiertypemetadata/Classificatie>;
  skos:inScheme <https://knb.poolparty.biz/dossiertypemetadata/dossiertype> .

<https://knb.poolparty.biz/dossiertypemetadata/DossiertypeCode> a skos:Concept;
  skos:prefLabel "DossiertypeCode"@nl;
  skos:definition "Functionele identificatie van het dossiertype. Dit kan hetzelfde zijn als Dossiertype OF een identificatie voor uitwisseling met andere applicaties."@nl;
  skos:scopeNote "Dit kan afkomstig zijn uit het DMS of uit een externe bron zoals een bronapplicatie of ZTC"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/dossiertypemetadata/DMS>, <https://knb.poolparty.biz/dossiertypemetadata/Bronapplicatie>,
    <https://knb.poolparty.biz/dossiertypemetadata/String>, <https://knb.poolparty.biz/dossiertypemetadata/nul-tot-een>,
