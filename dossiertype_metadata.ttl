<https://knb.poolparty.biz/dossiertypemetadata/Aggregatieniveau> a skos:Concept;
  skos:prefLabel "Aggregatieniveau"@nl;
  skos:definition "Het aggregatieniveau van het informatieobject."@nl;
  skos:scopeNote "Zie de inleiding voor meer toelichting over aggregaties."@nl;
