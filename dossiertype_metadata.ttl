  skos:inScheme <https://knb.poolparty.biz/dossiertypemetadata/dossiertype> .

<https://knb.poolparty.biz/dossiertypemetadata/DossiertypeCodeBron> a skos:Concept;
  skos:prefLabel "DossiertypeCodeBron"@nl;
  skos:definition "Alleen invullen indien dit uit een externe bronapplicatie komt. Indien leeg dan komt het dossiertype uit het DMS"@nl;
  skos:scopeNote "Dit kan afkomstig zijn uit het DMS of uit een externe bron zoals een bronapplicatie of ZTC"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
