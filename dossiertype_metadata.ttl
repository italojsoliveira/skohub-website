<https://knb.poolparty.biz/dossiertypemetadata/Object-type> a skos:Concept;
  skos:prefLabel "Object type"@nl;
  skos:definition "Bedoeld om records op verschillende hiërarchische niveaus (bijvoorbeeld: document, dossier, bestand) te kunnen groeperen. Door afspraken te maken tussen organisaties over te onderscheiden aggregatieniveaus kan informatie/records gemakkelijker uitgewisseld worden."@nl;
  skos:scopeNote "Content type 'rdoc:dossiertypefolder' met cm:folder als base type. Dit is op dit niveau gelijk aan 'Serie'"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/dossiertypemetadata/DMS>, <https://knb.poolparty.biz/dossiertypemetadata/String>,
    <https://knb.poolparty.biz/dossiertypemetadata/een-tot-een>, <https://knb.poolparty.biz/dossiertypemetadata/Aggregatieniveau>;
  skos:inScheme <https://knb.poolparty.biz/dossiertypemetadata/dossiertype> .

<https://knb.poolparty.biz/dossiertypemetadata/Object-ID> a skos:Concept;
  skos:prefLabel "Object ID"@nl;
  skos:definition "Technische ID in het DMS om een dossier uniek te kunnen identificeren."@nl;
  skos:scopeNote "cmis:objectId is ook nodig voor het ophalen van de node en is onderdeel van de Raadpleeglocatie"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/dossiertypemetadata/DMS>, <https://knb.poolparty.biz/dossiertypemetadata/String>,
    <https://knb.poolparty.biz/dossiertypemetadata/een-tot-een>, <https://knb.poolparty.biz/dossiertypemetadata/Identificatiekenmerk>;
  skos:inScheme <https://knb.poolparty.biz/dossiertypemetadata/dossiertype> .

<https://knb.poolparty.biz/dossiertypemetadata/Naam> a skos:Concept;
  skos:prefLabel "Naam"@nl;
  skos:definition "Beknopte formeelinhoudelijk beschrijving (titel) van het record"@nl;
  skos:broader <https://knb.poolparty.biz/dossiertypemetadata/Veldnaam>;
  skos:related <https://knb.poolparty.biz/dossiertypemetadata/DMS>, <https://knb.poolparty.biz/dossiertypemetadata/String>,
